# 主模型：支持 DeepSeek 等 OpenAI 兼容服务。不要把真实密钥提交到 Git。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# 新 Agent 自己的 PostgreSQL。
AGENT_DATABASE_URL=postgresql+asyncpg://agent:agent_dev_password@localhost:5434/agent

# 新 Agent 自己的评论向量库。
QDRANT_URL=http://127.0.0.1:6335
QDRANT_COLLECTION=new_agent_review_segments_v1

# 本地向量模型。模型权重可以放在 D 盘，不需要复制进 Git。
LOCAL_EMBEDDING_MODEL_PATH=D:\models\Qwen3-Embedding-0.6B
LOCAL_EMBEDDING_PYTHON=D:\anaconda3\python.exe
LOCAL_EMBEDDING_DEVICE=cuda
